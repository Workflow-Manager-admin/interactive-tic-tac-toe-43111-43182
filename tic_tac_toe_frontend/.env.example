# Example environment variables for Tic Tac Toe frontend
#
# You can define any API or site variables here.
# For future use if backend/game service is added:
# REACT_APP_BACKEND_URL=https://api.example.com

# For setting a site URL (required for auth/email redirects if future user accounts are added)
# REACT_APP_SITE_URL=https://mytic-tac-toe-site.com
